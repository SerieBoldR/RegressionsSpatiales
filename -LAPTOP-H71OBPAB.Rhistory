library(ggplot2)
b <- 5000
df1 <- data.frame(Distance= 1:15000, kernel = "Fonction gaussienne")
df2 <- data.frame(Distance= 1:15000, kernel = "Fonction exponentielle")
df3 <- data.frame(Distance= 1:15000, kernel = "Fonction bicarrée")
df4 <- data.frame(Distance= 1:15000, kernel = "Fonction tricube")
df1$Ponderation <- exp(-.5*(df1$Distance/b)^2)
df2$Ponderation <- exp(-1*df1$Distance/b)
df3$Ponderation  <- ifelse(df2>b, 0, 1-((df2$Distance/b)^2)^2)
df4$Ponderation  <- ifelse(df4>b, 0, 1-((df2$Distance/b)^3)^3)
df5 <- rbind(df1, df2, df3, df4)
ggplot(data = df5)+
geom_path(aes(x = Distance, y = Ponderation, color = kernel), linewidth = 1)+
labs(x = "Distance (en mètres)",
y = "Pondération",
color = "",
title = '') +
geom_vline(xintercept = b, linewidth = 1, col="gray50") +
annotate(geom="text", x = b + 250, y=.75,
label=paste0("b = ",as.character(b)), color="black", hjust = 0, size = 4)
